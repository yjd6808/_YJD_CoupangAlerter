<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net6.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
  </PropertyGroup>

  <ItemGroup>
    <None Remove="Resources\Icons\close_144.png" />
    <None Remove="Resources\Icons\minimize.png" />
    <None Remove="Resources\Icons\Pin.ico" />
    <None Remove="Resources\Icons\PinOff.ico" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\RequestApi\RequestApi.csproj" />
    <ProjectReference Include="..\WebFetch\WebFetch.csproj">
      <ReferenceOutputAssembly>false</ReferenceOutputAssembly>
    </ProjectReference>
  </ItemGroup>

  <Target Name="CopyWebFetchOutput" AfterTargets="Build">
    <MSBuild Projects="..\WebFetch\WebFetch.csproj" Targets="Build" Properties="Configuration=$(Configuration)">
      <Output TaskParameter="TargetOutputs" ItemName="WebFetchOutput" />
    </MSBuild>
    <Copy SourceFiles="@(WebFetchOutput)" DestinationFolder="$(OutputPath)" SkipUnchangedFiles="true" />
  </Target>

  <ItemGroup>
    <PackageReference Include="System.Speech" Version="6.0.0" />
  </ItemGroup>

  <ItemGroup>
    <Resource Include="Resources\Icons\close_144.png" />
    <Resource Include="Resources\Icons\minimize.png" />
    <Resource Include="Resources\Icons\Pin.ico" />
    <Resource Include="Resources\Icons\PinOff.ico" />
  </ItemGroup>

</Project>
